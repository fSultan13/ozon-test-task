# Go reads process environment; it does not load this file automatically.
STORAGE=memory
HTTP_ADDR=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_MAX_BODY_BYTES=1048576
LOG_LEVEL=info
LOG_FORMAT=json
# Read only for postgres; ignored completely in memory mode.
# In Compose the database hostname is postgres.
DATABASE_URL=postgres://shortener:shortener@localhost:5432/shortener?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_OPERATION_TIMEOUT=3s
# Read only for STORAGE=memory. The directory is created with mode 0700.
MEMORY_FILE=data/links.db
# Maximum cached links (0 disables the application cache); not a process RSS cap.
MEMORY_CACHE_ENTRIES=10000
# Maximum database file bytes, including indexes and metadata (minimum 65536).
MEMORY_MAX_DISK_BYTES=1073741824
MEMORY_OPERATION_TIMEOUT=3s
MEMORY_BATCH_SIZE=128
MEMORY_BATCH_DELAY=1ms
MEMORY_MAX_PENDING_WRITES=1024
