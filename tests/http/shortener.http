### URL exceeding the domain limit (8001 ASCII bytes, below the HTTP body limit)
< {%
    request.variables.set("overlongURLBody", JSON.stringify({url: "https://example.com/" + "a".repeat(8001 - "https://example.com/".length)}));
%}
POST {{baseUrl}}/links
Content-Type: application/json

{{overlongURLBody}}

> {%
    client.test("URL byte limit is enforced", function () {
        client.assert(response.status === 400, "Expected 400");
        client.assert(response.body.code === "invalid_request" && response.body.message === "Invalid request", "Unexpected error body");
    });
%}

### Body exceeding the default HTTP_MAX_BODY_BYTES=1048576
< {%
    request.variables.set("oversizedBody", JSON.stringify({url: "https://example.com/" + "a".repeat(1048576)}));
%}
POST {{baseUrl}}/links
Content-Type: application/json

{{oversizedBody}}

> {%
    client.test("HTTP body limit is enforced", function () {
        client.assert(response.status === 413, "Expected 413");
        client.assert(response.contentType.mimeType === "application/json", "Expected JSON");
        client.assert(response.body.code === "payload_too_large" && response.body.message === "Payload too large", "Unexpected error body");
    });
%}

### Unsupported method uses the standard ServeMux response
DELETE {{baseUrl}}/links/{{e2eCode}}

> {%
    client.test("Unsupported method returns 405 and Allow", function () {
        client.assert(response.status === 405, "Expected 405");
        const allowed = (response.headers.valueOf("Allow") || "").split(/,\s*/);
        client.assert(allowed.includes("GET"), "GET is missing from Allow");
    });
%}

### Unknown route uses the standard ServeMux response
GET {{baseUrl}}/e2e-unknown-route

> {%
    client.test("Unknown route returns 404", function () {
        client.assert(response.status === 404, "Expected 404");
    });
%}

### Rejected requests must not damage the original association
GET {{baseUrl}}/links/{{e2eCode}}

> {%
    client.test("Original link is still available", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.url === client.global.get("e2eOriginal"), "Stored association changed");
    });
%}
