# JetBrains HTTP Client (GoLand / IntelliJ IDEA): Run All Requests in order.
# Start the API with PUBLIC_BASE_URL=http://localhost:8080 and default body limit.
# baseUrl is the API address; e2ePublicBaseUrl below must match PUBLIC_BASE_URL.
@baseUrl = http://localhost:8080

### Liveness and initialize this run (do not reuse globals from a previous run)
< {%
    client.global.clear("e2eCode");
    client.global.clear("e2eShortUrl");
    client.global.set("e2ePublicBaseUrl", "http://localhost:8080");
    client.global.set("e2eOriginal", "https://example.com/a%2Fb?run=" + Date.now() + "-" + Math.random().toString(36).slice(2) + "&q=%2f#Fragment");
%}
GET {{baseUrl}}/healthz

> {%
    client.test("API is alive", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.contentType.mimeType === "application/json", "Expected JSON");
        client.assert(response.body.status === "ok", "Expected ok");
    });
%}

### Readiness (checks the database in PostgreSQL mode)
GET {{baseUrl}}/readyz

> {%
    client.test("Storage is ready", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.contentType.mimeType === "application/json", "Expected JSON");
        client.assert(response.body.status === "ok", "Expected ok");
    });
%}

### Create a short link; untrusted headers must not affect its public address
POST {{baseUrl}}/links
Content-Type: application/json; charset=utf-8
Forwarded: host=attacker.example;proto=https
X-Forwarded-Host: attacker.example
X-Forwarded-Proto: https

{"url":"{{e2eOriginal}}"}

> {%
    client.test("Short URL uses the configured base and a 10-character code", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.contentType.mimeType === "application/json", "Expected JSON");
        client.assert(Object.keys(JSON.parse(JSON.stringify(response.body))).join() === "short_url", "Unexpected response fields");
        const prefix = client.global.get("e2ePublicBaseUrl") + "/links/";
        const shortUrl = response.body.short_url;
        client.assert(typeof shortUrl === "string" && shortUrl.startsWith(prefix), "Unexpected public base URL");
        const code = shortUrl.slice(prefix.length);
        client.assert(/^[a-zA-Z0-9_]{10}$/.test(code), "Invalid generated code");
        client.global.set("e2eCode", code);
        client.global.set("e2eShortUrl", shortUrl);
    });
%}

### Resolve via the API address (also works when PUBLIC_BASE_URL is external)
# @no-redirect
GET {{baseUrl}}/links/{{e2eCode}}

> {%
    client.test("GET returns the exact original URL as JSON without redirecting", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.contentType.mimeType === "application/json", "Expected JSON");
        client.assert(!response.headers.valueOf("Location"), "Unexpected redirect header");
        client.assert(Object.keys(JSON.parse(JSON.stringify(response.body))).join() === "url", "Unexpected response fields");
        client.assert(response.body.url === client.global.get("e2eOriginal"), "Original URL was changed");
    });
%}

### Submitting the same original URL must return the same short URL
POST {{baseUrl}}/links
Content-Type: application/json

{"url":"{{e2eOriginal}}"}

> {%
    client.test("Repeated POST is idempotent", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.short_url === client.global.get("e2eShortUrl"), "Duplicate URL received another code");
    });
%}

### A distinct original URL must receive a distinct code
POST {{baseUrl}}/links
Content-Type: application/json

{"url":"{{e2eOriginal}}-different"}

> {%
    client.test("Different URLs have different codes", function () {
        client.assert(response.status === 200, "Expected 200");
        const prefix = client.global.get("e2ePublicBaseUrl") + "/links/";
        client.assert(typeof response.body.short_url === "string" && response.body.short_url.startsWith(prefix), "Unexpected public base URL");
        const code = response.body.short_url.slice(prefix.length);
        client.assert(/^[a-zA-Z0-9_]{10}$/.test(code), "Invalid generated code");
        client.assert(response.body.short_url !== client.global.get("e2eShortUrl"), "Code was reused for another URL");
        client.global.set("e2eOtherCode", code);
    });
%}

### Resolve the second link to check that the stored associations did not mix
GET {{baseUrl}}/links/{{e2eOtherCode}}

> {%
    client.test("Second code resolves to the second URL", function () {
        client.assert(response.status === 200, "Expected 200");
        client.assert(response.body.url === client.global.get("e2eOriginal") + "-different", "Wrong stored association");
    });
%}

### A valid one-character code cannot be generated by the current generator
GET {{baseUrl}}/links/_

> {%
    client.test("Unknown valid code returns the documented error", function () {
        client.assert(response.status === 404, "Expected 404");
        client.assert(response.contentType.mimeType === "application/json", "Expected JSON");
        client.assert(JSON.stringify(response.body) === JSON.stringify({code: "not_found", message: "Link not found"}), "Unexpected error body");
    });
%}

### Invalid code alphabet
GET {{baseUrl}}/links/bad-code

> {%
    client.test("Invalid code is rejected", function () {
        client.assert(response.status === 400, "Expected 400");
        client.assert(response.body.code === "invalid_request" && response.body.message === "Invalid request", "Unexpected error body");
    });
%}

### Code longer than ten characters
GET {{baseUrl}}/links/abcdefghijk

> {%
    client.test("Overlong code is rejected", function () {
        client.assert(response.status === 400, "Expected 400");
        client.assert(response.body.code === "invalid_request" && response.body.message === "Invalid request", "Unexpected error body");
    });
%}

